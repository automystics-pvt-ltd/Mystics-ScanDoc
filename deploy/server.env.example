# =============================================================================
#  DocScan — Server Environment Variables
#  Copy this file to /home/automystics-docscan/app/.env on the server
#  and fill in all values before the first deploy.
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://docscan_user:CHANGE_ME@localhost:5432/docscan_prod

# ── Auth ──────────────────────────────────────────────────────────────────────
SESSION_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_STRING_AT_LEAST_64_CHARS
JWT_SECRET=CHANGE_ME_ANOTHER_LONG_RANDOM_STRING

# ── API server ────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ── Email (choose one provider) ───────────────────────────────────────────────
# NOTE: The Replit Resend connector does NOT work outside of Replit.
#       Configure SMTP or a direct provider API key in Admin → Settings
#       after first boot. Or pre-set it here for the DB seed:
#
# SMTP (works with Gmail, Mailgun, SendGrid, etc.)
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@yourdomain.com
# SMTP_PASS=your_smtp_password

# Direct Resend API key (bypasses Replit connector)
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxxxxxx

# ── Optional ──────────────────────────────────────────────────────────────────
# CORS_ORIGIN=https://docscan.automystics.tech
# LOG_LEVEL=info
